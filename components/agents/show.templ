package agents

import (
	"fmt"
	"go-crawler-notification/components/layouts"
	"go-crawler-notification/models"
	"time"
)

templ Show(props layouts.PageProps, agent models.Agent, events []models.MonitorEvent, syslogs []models.SystemLog, running bool, webhooks []models.Webhook) {
	@layouts.Base(props) {
		<div class="container agent-show">
			<div class="row">
				<!-- Left: Tab navigation -->
				<div class="col-md-2">
					<ul class="nav nav-pills nav-stacked" id="show-tabs">
						<li>
							<a href="/agents">
								<span class="glyphicon glyphicon-chevron-left"></span> Back
							</a>
						</li>
						<li class="active">
							<a href="#details" data-toggle="tab">
								<span class="glyphicon glyphicon-indent-left"></span> Details
							</a>
						</li>
						<li>
							<a href="#logs" data-toggle="tab" data-agent-id={ agent.ID } class="">
								<span class="glyphicon glyphicon-list-alt"></span> Logs
							</a>
						</li>
						<li>
							<a href="#webhooks" data-toggle="tab">
								<span class="glyphicon glyphicon-link"></span> Webhooks
							</a>
						</li>
						<li class="dropdown">
							<a class="dropdown-toggle" data-toggle="dropdown" href="#">
								<span class="glyphicon glyphicon-th-list"></span> Actions <span class="caret"></span>
							</a>
							@ActionMenu(agent, running, fmt.Sprintf("/agents/%s", agent.ID))
						</li>
					</ul>
				</div>
				<!-- Right: Tab content -->
				<div class="col-md-10">
					<div class="tab-content">
						<!-- Details tab (active by default) -->
						<div class="tab-pane active" id="details">
							<h2>{ agent.Name } Details</h2>
							<p>
								<b>상태:</b> @StatusBadge(running)
							</p>
							<p>
								<b>URL:</b>
								<a href={ templ.URL(agent.URL) } target="_blank" style="word-break:break-all;">{ agent.URL }</a>
							</p>
							<p>
								<b>키워드:</b>
								if agent.Keyword != "" {
									<code>{ agent.Keyword }</code>
								} else {
									<span class="text-muted">-</span>
								}
							</p>
							<p>
								<b>감지 옵션:</b> @DetectionBadges(agent)
							</p>
							<p>
								<b>폴링 주기:</b> { fmt.Sprintf("%d초", agent.IntervalSeconds) }
							</p>
							<p>
								<b>첫 감지 알림:</b>
								if agent.AlertOnFirstSeen {
									<span class="label label-warning">ON</span>
								} else {
									<span class="label label-default">OFF</span>
								}
							</p>
						</div>
						<!-- Logs tab -->
						<div class="tab-pane" id="logs" data-agent-id={ agent.ID }>
							<div class="row">
								<div class="col-md-12">
									<h2>
										{ agent.Name } Logs
										<small>
											<img src="/static/images/spinner-arrows.gif" class="spinner" style="display:none;"/>
											<span class="glyphicon glyphicon-refresh action-icon refresh" style="cursor:pointer;margin:0 10px;"></span>
											<span class="glyphicon glyphicon-trash action-icon clear" style="cursor:pointer;"></span>
										</small>
									</h2>
								</div>
							</div>
							<div class="row">
								<div class="col-md-12">
									<div class="logs">
										@SystemLogsTable(syslogs)
									</div>
								</div>
							</div>
						</div>
						<!-- Webhooks tab -->
						<div class="tab-pane" id="webhooks">
							<h2>
								<i class="fa fa-link"></i> { agent.Name } Webhooks
								<a href="/webhooks/new" class="btn btn-xs btn-default pull-right" style="margin-top:8px;">+ 추가</a>
							</h2>
							if len(webhooks) == 0 {
								<p class="text-muted">연결된 웹훅이 없습니다.</p>
							} else {
								<table class="table table-striped">
									<thead>
										<tr>
											<th>종류</th>
											<th>이름</th>
										</tr>
									</thead>
									<tbody>
										for _, wh := range webhooks {
											<tr>
												<td><span class={ fmt.Sprintf("label label-%s", webhookKindClass(wh.Kind)) }>{ wh.Kind }</span></td>
												<td>{ wh.Name }</td>
											</tr>
										}
									</tbody>
								</table>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

// ── SystemLog 테이블 ──────────────────────────────────────────

templ SystemLogsTable(logs []models.SystemLog) {
	<div class="table-responsive">
		<table id="event-log" class="table table-striped table-row-middle logs">
			<tr>
				<th width="160px">Tag</th>
				<th>Message</th>
				<th>When</th>
				<th width="100px"></th>
			</tr>
			if len(logs) == 0 {
				<tr id="no-events-msg">
					<td colspan="4" class="text-center text-muted">
						<i class="fa fa-clock"></i> 로그 없음
					</td>
				</tr>
			}
			for _, sl := range logs {
				@SystemLogRow(sl)
			}
		</table>
	</div>
}

templ SystemLogRow(sl models.SystemLog) {
	<tr class={ fmt.Sprintf("event-row event-row-%s", syslogLevelClass(sl.Level)) }>
		<td>
			<span class={ fmt.Sprintf("label label-%s", syslogLabelClass(sl.Tag)) }>{ sl.Tag }</span>
		</td>
		<td>{ truncate(sl.Message, 200) }</td>
		<td>{ timeAgo(sl.OccurredAt) } ago</td>
		<td>
			<div class="btn-group btn-group-xs">
				<a
					href="#"
					class="btn btn-default show-log-details"
					data-modal-title={ sl.Tag }
					data-modal-content={ sl.Message }
				>Details</a>
			</div>
		</td>
	</tr>
}

// ── EventsTable (SSE 실시간용 — show.templ 내부에서만 사용) ──

templ EventsTable(events []models.MonitorEvent) {
	<div class="table-responsive">
		<table id="event-log" class="table table-striped table-row-middle logs">
			<tr>
				<th>Message</th>
				<th>When</th>
				<th width="200px"></th>
			</tr>
			if len(events) == 0 {
				<tr id="no-events-msg">
					<td colspan="3" class="text-center text-muted">
						<i class="fa fa-clock"></i> 이벤트 대기 중...
					</td>
				</tr>
			}
			for i, ev := range events {
				@EventRow(ev, i)
			}
		</table>
	</div>
}

templ EventRow(ev models.MonitorEvent, idx int) {
	<tr class={ fmt.Sprintf("event-row event-row-%s", ev.Status) }>
		<td>{ truncate(ev.Message, 200) }</td>
		<td>{ timeAgo(ev.OccurredAt) } ago</td>
		<td>
			<div class="btn-group btn-group-xs">
				<a
					href="#"
					class="btn btn-default show-log-details"
					data-modal-title="Info"
					data-modal-content={ ev.Message }
				>Details</a>
			</div>
		</td>
	</tr>
}

// ── 헬퍼 함수 ────────────────────────────────────────────────

func syslogLevelClass(level string) string {
	switch level {
	case "error":
		return "danger"
	case "warn":
		return "warning"
	default:
		return "info"
	}
}

func syslogLabelClass(tag string) string {
	switch tag {
	case "NEW_VERSION", "FIRST_SEEN_VERSION":
		return "success"
	case "HTTP_REQUEST":
		return "primary"
	case "HTTP_RESPONSE":
		return "info"
	case "NOTIFY_ERROR", "NOTIFY_CFG_ERROR", "VERSION_PARSE_FAILED", "VERSION_LOWER":
		return "danger"
	default:
		return "default"
	}
}

func timeAgo(t time.Time) string {
	diff := time.Since(t)
	minutes := diff.Minutes()
	hours := diff.Hours()
	days := hours / 24
	switch {
	case minutes < 1:
		return "less than a minute"
	case minutes < 2:
		return "1 minute"
	case minutes < 45:
		return fmt.Sprintf("%d minutes", int(minutes))
	case minutes < 90:
		return "about 1 hour"
	case hours < 24:
		return fmt.Sprintf("about %d hours", int(hours))
	case hours < 42:
		return "1 day"
	case days < 30:
		return fmt.Sprintf("%d days", int(days))
	case days < 45:
		return "about 1 month"
	case days < 365:
		return fmt.Sprintf("%d months", int(days/30))
	case days < 548:
		return "about 1 year"
	default:
		return fmt.Sprintf("%d years", int(days/365))
	}
}

func webhookKindClass(kind string) string {
	switch kind {
	case "slack":
		return "success"
	case "telegram":
		return "info"
	default:
		return "default"
	}
}
