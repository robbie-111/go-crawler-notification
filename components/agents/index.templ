package agents

import (
	"fmt"
	"go-crawler-notification/components/layouts"
	"go-crawler-notification/models"
)

templ Index(props layouts.PageProps, agents []models.Agent, runningIDs map[string]bool, webhooks map[string]models.Webhook) {
	@layouts.Base(props) {
		<div class="page-header">
			<h1>
				<i class="fa fa-robot"></i> Agents
				<a href="/agents/new" class="btn btn-primary btn-sm pull-right">
					<i class="fa fa-plus"></i> New Agent
				</a>
			</h1>
		</div>
		if len(agents) == 0 {
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i>
				등록된 에이전트가 없습니다.
				<a href="/agents/new">새 에이전트를 만들어 보세요.</a>
			</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>이름</th>
							<th>URL</th>
							<th>키워드</th>
							<th>주기</th>
							<th>상태</th>
							<th>액션</th>
						</tr>
					</thead>
					<tbody>
						for _, agent := range agents {
							@AgentRow(agent, runningIDs[agent.ID], webhooks)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ AgentRow(agent models.Agent, running bool, webhooks map[string]models.Webhook) {
	<tr>
		<td>
			<a href={ templ.URL(fmt.Sprintf("/agents/%s", agent.ID)) }>
				<strong>{ agent.Name }</strong>
			</a>
			<br/>
			@DetectionBadges(agent)
			@SlackBadges(agent, webhooks)
		</td>
		<td>
			<small class="text-muted" title={ agent.URL }>
				{ truncate(agent.URL, 40) }
			</small>
		</td>
		<td>
			if agent.Keyword != "" {
				<code>{ agent.Keyword }</code>
			} else {
				<span class="text-muted">-</span>
			}
		</td>
		<td>
			<small>{ fmt.Sprintf("%ds", agent.IntervalSeconds) }</small>
		</td>
		<td>
			@StatusBadge(running)
		</td>
		<td>
			<div class="btn-group">
				<button type="button" class="btn btn-default btn-xs dropdown-toggle" data-toggle="dropdown">
					<span class="glyphicon glyphicon-th-list"></span> Actions <span class="caret"></span>
				</button>
				@ActionMenu(agent, running, "/agents")
			</div>
		</td>
	</tr>
}

templ DetectionBadges(agent models.Agent) {
	if agent.EnableKeyword {
		<span class="label label-info">키워드</span>
	}
	if agent.EnableVersion {
		<span class="label label-primary">버전</span>
	}
}

templ SlackBadges(agent models.Agent, webhooks map[string]models.Webhook) {
	for _, wid := range agent.WebhookIDs {
		if wh, ok := webhooks[wid]; ok && wh.Kind == "slack" {
			<a
				href={ templ.URL(fmt.Sprintf("/webhooks/%s/edit", wh.ID)) }
				class="label"
				style="background-color:#4A154B;color:#fff;margin-left:2px;"
				title={ wh.URL }
			>
				<i class="fa-brands fa-slack"></i> { wh.Name }
			</a>
		}
	}
}

templ StatusBadge(running bool) {
	if running {
		<span class="label label-success"><i class="fa fa-circle"></i> 실행 중</span>
	} else {
		<span class="label label-default"><i class="fa fa-circle"></i> 중지</span>
	}
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "..."
}
